# SQL Server - eAuren (Base de datos fuente)
AUREN_SERVER=your_sql_server\instance
AUREN_DB=your_database
AUREN_USER=your_sql_user
AUREN_PASSWORD=your_password_here
AUREN_DRIVER=ODBC Driver 17 for SQL Server

# SQL Server - pbi2 (Base de datos destino TOA)
TOA_SERVER=your_sql_server\instance
TOA_DB=your_database
TOA_USER=your_sql_user
TOA_PASSWORD=your_password_here
TOA_DRIVER=ODBC Driver 17 for SQL Server

# Credenciales TOA Portal (login web)
TOA_PORTAL_USERNAME=your_toa_username
TOA_PORTAL_PASSWORD=your_toa_password

# SQL Server - pbi2 (Usuarios Telegram bot)
TG_USUARIOS_USER=your_sql_user
TG_USUARIOS_PASSWORD=your_password_here

# Telegram Bot
TELEGRAM_TOKEN=your_telegram_token_here

# VENTORY (Google Sheet "Integratel-GrupoAuren", hoja REG_VTAS_BBDD) — LEGADO
# Ya no es la fuente de FEs (reemplazado por VENTORY Postgres, ver abajo,
# migración 2026-08-24). Opcional: solo necesario si se vuelve a usar
# scripts_db/ventory_sheet.py (utilidad legado, sin uso en el flujo productivo).
VENTORY_SHEET_ID=your_google_sheet_id
VENTORY_SHEET_GID=your_sheet_gid
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# VENTORY Postgres (ventas_db) — fuente real de FEs pendientes, vía
# codigo_seguridad (FE) y codigo_seguridad_2 (= eAuren.peticion). Usada por
# query_fe_filter.py, mantenimiento_continuo.py y consultar_estado_fe.py.
host=your_ventory_pg_host
port=5433
tabla=ventas_db
user=your_ventory_pg_user
password=your_password_here

# WhatsApp Server — instancia "Yugi Backoffice" (wa_toa_server.js, puerto 8003)
# Numero dedicado al bot de consulta de estado TOA, separado del numero
# personal usado en AVANCE_MOVISTAR/SSFF/PBI/VPN (wa_server.js, puerto 8002)
OWNER_WA_ID_TOA=51900000000
# Proxy corporativo, solo si aplica en el entorno de despliegue
HTTP_PROXY=
PROXY_USER=
PROXY_PASS=

# Alertas por correo de wa_toa_server.js (via notify_error.py, Gmail API/OAuth)
NOTIFY_ERROR_DESTINATARIO=your_alert_email@example.com

# send_mail.py (SMTP + contraseña de aplicacion) - opcional, no usado en el
# flujo productivo hoy (notify_error.py usa Gmail API/OAuth en su lugar).
GMAIL_REMITENTE=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_DESTINATARIO=your_gmail@gmail.com
